// The app's screen: the permission, the reminders with their switches, and a toast when a
// notification opens the app.
import <string>;
import <ui>;
import <ui/kit>;
import <notifications>;

int64 ink() { return rgb(17, 24, 39); }
int64 muted() { return rgb(107, 114, 128); }
int64 page() { return rgb(245, 246, 250); }
int64 card() { return rgb(255, 255, 255); }
int64 line() { return rgb(229, 231, 235); }
int64 violet() { return rgb(124, 58, 237); }
int64 violet_soft() { return rgb(237, 233, 254); }

struct Reminder { string id; string icon; string title; string body; string when; int seconds; int64 soft; }

const int kReminders = 4;

Reminder reminder(int i) {
    if (i == 0) { return Reminder{"tea", "🍵", "Tea is ready", "Four minutes are up: take the leaves out.", "In 10 seconds", 10, rgb(220, 252, 231)}; }
    if (i == 1) { return Reminder{"stretch", "🧘", "Time to stretch", "Stand up and loosen your shoulders for a minute.", "In 20 minutes", 1200, rgb(224, 242, 254)}; }
    if (i == 2) { return Reminder{"water", "💧", "Drink some water", "A glass now keeps the afternoon headache away.", "In 1 hour", 3600, rgb(219, 234, 254)}; }
    return Reminder{"call", "📞", "Call Mom", "She asked how the trip went.", "Tonight at 8", 6 * 3600, rgb(254, 243, 199)};
}

// A row: the reminder and a switch that schedules or cancels it.
void ReminderRow(int i, *Signal<int> on) {
    Reminder r = reminder(i);
    bool scheduled = (on.get() & (1 << i)) != 0;
    Row(Style{key: key(i), padding: 14, gap: 14, radius: 18, background: card(), border_width: 1, border_color: line(),
              align: AlignCenter, label: r.title}) {
        Row(Style{width: 46, height: 46, radius: 14, background: r.soft, align: AlignCenter, justify: JustifyCenter}) { TextWith(Style{font_size: 24}, r.icon); }
        Column(Style{grow: 1, gap: 2}) {
            TextWith(Style{font_size: 17, font_weight: 700, color: ink()}, r.title);
            TextWith(Style{font_size: 14, color: scheduled ? violet() : muted()}, scheduled ? r.when : "Off");
        }
        Switch(Style{}, scheduled, void(bool value) {
            if (value) { notification_schedule(r.id, r.title, r.body, r.seconds); }
            else { notification_cancel(r.id); }
            on.set(value ? on.value | (1 << i) : on.value & ~(1 << i));
        });
    }
}

void PermissionCard(int permission) {
    Column(Style{padding: 20, gap: 12, radius: 22, background: violet(), shadow: 10}) {
        TextWith(Style{font_size: 20, font_weight: 800, color: rgb(255, 255, 255)},
            permission == NotificationsDenied ? "Notifications are off" : "Turn on notifications");
        TextWith(Style{font_size: 15, color: rgba(255, 255, 255, 215)},
            permission == NotificationsDenied ? "Allow them for Reminders in the system's settings to get your reminders."
                                              : "Reminders tells you when it is time, even when the app is closed.");
        if (permission != NotificationsDenied) {
            Row(Style{}) {
                ButtonWith(Style{padding: 12, radius: 12, background: rgb(255, 255, 255), color: violet(), font_weight: 700},
                    "Allow notifications") { notifications_ask(); }
            }
        }
    }
}

void Reminders() {
    Column(Style{grow: 1, background: page(), gap: 0}) {
        StatusBar(BarDark, false);
        int permission = use_notification_permission();
        *Signal<int> on = use_signal<int>(0);
        use_notification_opened(void(string id) {
            for (i in 0..kReminders) {
                Reminder r = reminder(i);
                if (strcmp(r.id, id) == 0) {
                    String text;
                    defer String_free(&text);
                    String_format(&text, "Opened: %s", r.title);
                    kit_toast(text.data);
                    on.set(on.value & ~(1 << i));
                }
            }
        });
        Scroll(Style{grow: 1, padding: 20, gap: 16}) {
            Row(Style{align: AlignCenter, gap: 12}) {
                Column(Style{grow: 1, gap: 2}) {
                    TextWith(Style{font_size: 15, color: muted()}, "Today");
                    TextWith(Style{font_size: 34, font_weight: 800, color: ink()}, "Reminders");
                }
                String count;
                defer String_free(&count);
                int n = 0;
                for (i in 0..kReminders) { if ((on.get() & (1 << i)) != 0) { n++; } }
                String_format(&count, "%d on", n);
                Row(Style{padding: 8, radius: 999, background: violet_soft()}) {
                    TextWith(Style{font_size: 13, font_weight: 700, color: violet()}, count.data);
                }
            }
            if (permission == NotificationsNotAsked || permission == NotificationsDenied) { PermissionCard(permission); }
            Column(Style{gap: 10}) { for (i in 0..kReminders) { ReminderRow(i, on); } }
            TextWith(Style{font_size: 14, color: muted()},
                "The first one arrives in ten seconds: switch it on, then leave the app or lock the screen.");
        }
        ToastHost();
    }
}
